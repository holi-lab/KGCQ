# Copy to .env (never commit). Loaded by kgcq.paths.load_env(); $KGCQ_ENV_FILE overrides the location.

# --- Azure OpenAI Service: all GPT calls (patient simulator gpt-4o-mini, GPT-4.1-mini HV baseline,
#     soft-label judge, profile annotation with gpt-5-nano / gpt-4o-mini) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
# Model names used in the code -> your Azure deployment names (JSON on one line). Unmapped names are used as-is.
AZURE_OPENAI_DEPLOYMENTS={"gpt-4o-mini-2024-07-18": "gpt-4o-mini", "gpt-4.1-mini": "gpt-4.1-mini", "gpt-5-nano-2025-08-07": "gpt-5-nano"}
# To use api.openai.com instead of Azure: KGCQ_OPENAI_PROVIDER=openai and OPENAI_API_KEY=sk-...
# KGCQ_OPENAI_PROVIDER=azure

# --- OpenRouter: non-OpenAI API baselines of Table 3 (Claude 3.5 Sonnet, Gemini 2.0 Flash, Llama 3.3 70B, Qwen2.5 72B) ---
OPENROUTER_API_KEY=

# --- optional ---
WANDB_API_KEY=
